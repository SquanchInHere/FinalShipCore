#menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

#screen-container {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 80px;
}

#dialog-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}